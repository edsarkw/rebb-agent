{
  "display_information": {
    "name": "REBB Brief",
    "description": "Posts Ed's morning brief and routes one-tap approvals back to the agent.",
    "background_color": "#0a0a0a"
  },
  "features": {
    "bot_user": {
      "display_name": "REBB Brief",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://REPLACE-WITH-YOUR-RAILWAY-DOMAIN/slack/actions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
